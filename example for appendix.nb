Cell[CellGroupData[{

Cell["Add  power counting based on mass dimension to model", "Subsubsection",ExpressionUUID->"fdeac40a-2baa-4130-af23-acf41ecb70ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "@", "AddDimInfo"}], ";"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"171b07b1-af13-4408-ac2c-c3cfde995e0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddDimInfo", "[", "particleDict_Association", "]"}], ":=", 
   RowBox[{"Association", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sequence", "@@", 
       RowBox[{"Normal", "@", "particleDict"}]}], ",", 
      RowBox[{"\"\<dim\>\"", "->", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"particleDict", "[", "\"\<spin\>\"", "]"}], ",", 
           RowBox[{"particleDict", "[", "\"\<mass\>\"", "]"}]}], "}"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"_", ",", "0"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Abs", "@", 
           RowBox[{"particleDict", "[", "\"\<spin\>\"", "]"}]}], "+", "1"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"m_", "/;", 
            RowBox[{"m", "=!=", "0"}]}]}], "}"}], ",", "1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "2"}], ",", 
           RowBox[{"m_", "/;", 
            RowBox[{"m", "=!=", "0"}]}]}], "}"}], ",", 
         RowBox[{"3", "/", "2"}], ",", "_", ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Not support/Illegal:s=,m=\>\"", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"particleDict", "[", "\"\<spin\>\"", "]"}], ",", 
              RowBox[{"particleDict", "[", "\"\<mass\>\"", "]"}]}], "}"}]}], 
           "]"}], ";", "Infinity"}]}], "\[IndentingNewLine]", "]"}]}]}], 
     "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"cc9ba769-43bd-4367-9f91-f13d9b7adb62"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
DFS Select Combinations with d <= Dgiven with must have some particles\
\>", "Subsubsection",ExpressionUUID->"e1d66a65-91c2-4e49-9f29-7d4bbe5dfc79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "GenerateCombinationsParallel"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateCombinationsParallel", "[", 
   RowBox[{"model_Association", ",", "D_Integer", ",", 
    RowBox[{"must_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dims", ",", "keys", ",", 
      RowBox[{"prefix", "=", "must"}], ",", "mustSum", ",", "startIdx", ",", 
      "n", ",", "f", ",", "res"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dims", "=", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "->", 
          RowBox[{
           RowBox[{"model", "[", "#", "]"}], "[", "\"\<dim\>\"", "]"}]}], 
         "&"}], "/@", 
        RowBox[{"Keys", "[", "model", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"keys", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Keys", "[", "dims", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mustSum", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"dims", "/@", "prefix"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"mustSum", ">", "D"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"startIdx", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "keys", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"comb", ",", "sum", ",", "start"}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "out", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"out", "=", 
            RowBox[{"{", "comb", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"out", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"out", ",", "\[IndentingNewLine]", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"With", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"key", "=", 
                    RowBox[{"keys", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                    RowBox[{"d", "=", 
                    RowBox[{"dims", "[", 
                    RowBox[{"keys", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"sum", "+", "d"}], "<=", "D"}], ",", 
                    RowBox[{"f", "[", 
                    RowBox[{
                    RowBox[{"Append", "[", 
                    RowBox[{"comb", ",", "key"}], "]"}], ",", 
                    RowBox[{"sum", "+", "d"}], ",", "i"}], "]"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "start", ",", "n"}], "}"}]}], "]"}], ",",
                 "1"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           "out"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "prefix", "}"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"key", "=", 
                 RowBox[{"keys", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                RowBox[{"d", "=", 
                 RowBox[{"dims", "[", 
                  RowBox[{"keys", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"mustSum", "+", "d"}], "<=", "D"}], ",", 
                RowBox[{"f", "[", 
                 RowBox[{
                  RowBox[{"Join", "[", 
                   RowBox[{"prefix", ",", 
                    RowBox[{"{", "key", "}"}]}], "]"}], ",", 
                  RowBox[{"mustSum", "+", "d"}], ",", "i"}], "]"}], ",", 
                RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "startIdx", ",", "n"}], "}"}]}], "]"}], ",", 
          "1"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "//", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{"l_", "/;", 
        RowBox[{
         RowBox[{"Length", "@", "l"}], "<", "4"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"8f0176bb-73b9-4dbc-b47f-1c9f45f39f5f"]
}, Open  ]],

