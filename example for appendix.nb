 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    TagBox[GridBox[{
       {"1"},
       {"2"}
      },
      AutoDelete->False,
      GridBoxFrame->{
       "Columns" -> None, "Rows" -> None, 
        "ItemsIndexed" -> {{1, 1} -> True, {2, 1} -> True}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
     "Grid"], ",", 
