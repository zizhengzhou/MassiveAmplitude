Cell[CellGroupData[{

Cell["\<\
example : generate operator
for specific combination and dimension
5 pt mass dim 6, dark photon/ u/ ubar/ H/ Hdagger\
\>", "Subsection",ExpressionUUID->"29d6bc64-e52a-4574-a317-d3beb51efca5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"example", "=", 
   RowBox[{
    RowBox[{"AutoModelFun", "[", "DPModelAboveEW", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\"\<DP\>\"", ",", "\"\<ubar\>\"", ",", "\"\<u\>\"", ",", 
       "\"\<Hdag\>\"", ",", "\"\<H\>\""}], "}"}], ",", "6"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"f8da7ef8-ab38-4774-9280-6574c99f606a"],

Cell["\<\
Young tableaux for gauge group SU2/SU3 and amplitude basis 
with ab[x] as <x>,  sb[x] as [x], i=1..npt as massless limit i, i\
\[CloseCurlyQuote] = 2n,..n+1 as massive i\
\>", "Text",ExpressionUUID->"3f3eac81-ac6d-487f-a8bf-521ea9077a9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"example", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "/.", 
  RowBox[{
   RowBox[{"IYT", "[", "x___", "]"}], ":>", 
   RowBox[{"DisplayYT", "@", 
    RowBox[{"IYT", "[", "x", "]"}]}]}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"94635c88-de61-4032-a210-74e7a75aa5b8"],

